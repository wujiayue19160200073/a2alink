# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# 身份与数据库：绝对不要提交
identity.json
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# 本地策略（可能含项目代号/客户代号）
policy.json

# 审计日志：即使默认不存原文，也绝不能进仓库
logs/
audit.*.jsonl
HEAD.*

# 环境变量与密钥
.env
.env.*

# ⚠️ 私钥绝对不能进仓库。一旦提交，必须视为已泄露并立刻轮换
keys/
*.key
*.key.tmp
*.key.*.old

# 对端公钥固定表：泄露不致命（都是公钥），但会暴露你和谁通过信
trust/

# 编辑器
.vscode/
.idea/
.DS_Store
